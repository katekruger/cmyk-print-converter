# Build output. The bundle at the repo root IS committed on purpose (the README
# ships it as an install path); CI rebuilds it and fails if it drifts from source.
# Only the scratch build directory is ignored.
dist/

# Python / tooling caches
__pycache__/
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Secrets
.env

# macOS
.DS_Store
._*
__MACOSX/


# Conversion output
cmyk-out/

# Locally installed ICC profiles (licensed separately — see skills/convert-to-cmyk/references/swop-profile.md)
profiles/*.icc
